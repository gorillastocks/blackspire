default_platform(:ios)

BUNDLE_ID = "com.gorillastocks.blackspire"
MARKETING_VERSION = "1.0.0"

platform :ios do
  desc "Build with an ephemeral distribution cert + profile made through the App Store Connect API key, and upload to TestFlight"
  lane :beta do
    key_id = ENV.fetch("ASC_KEY_ID")
    issuer_id = ENV.fetch("ASC_ISSUER_ID")
    key_content = ENV.fetch("ASC_KEY_P8")

    certs_before = nil
    dist_types = %w[IOS_DISTRIBUTION DISTRIBUTION]
    begin
      api_key = app_store_connect_api_key(
        key_id: key_id,
        issuer_id: issuer_id,
        key_content: key_content,
        in_house: false
      )

      # Team ID = bundle ID prefix (seedId) of the already-registered App ID.
      bundle = Spaceship::ConnectAPI::BundleId.find(BUNDLE_ID)
      UI.user_error!("Bundle ID #{BUNDLE_ID} not found in App Store Connect") if bundle.nil?
      team_id = ENV["TEAM_ID"] || bundle.seed_id
      UI.message("Team ID resolved (#{team_id.to_s.length} chars)")

      build_number = latest_testflight_build_number(
        app_identifier: BUNDLE_ID,
        api_key: api_key,
        initial_build_number: 0
      ) + 1
      UI.message("Marketing version #{MARKETING_VERSION}, build #{build_number}")

      # The team has no registered devices, so Xcode automatic signing cannot make the development profile an archive
      # wants. Instead: an ephemeral App Store distribution certificate + profile, both created through the API key.
      # The certificate (and with it the profile) is deleted again at the end, so runs never pile up certificates.
      setup_ci
      certs_before = Spaceship::ConnectAPI::Certificate.all(filter: { certificateType: dist_types.join(",") }).map(&:id)
      cert(
        api_key: api_key,
        team_id: team_id,
        development: false,
        generate_apple_certs: true,
        keychain_path: File.expand_path("~/Library/Keychains/#{ENV["MATCH_KEYCHAIN_NAME"]}-db"),
        keychain_password: ""
      )

      profile_name = "Blackspire AppStore CI #{build_number}"
      sigh(
        api_key: api_key,
        app_identifier: BUNDLE_ID,
        team_id: team_id,
        provisioning_name: profile_name,
        force: true,
        include_all_certificates: false
      )

      update_code_signing_settings(
        use_automatic_signing: false,
        path: "ios/App/App.xcodeproj",
        team_id: team_id,
        targets: ["App"],
        build_configurations: ["Release"],
        code_sign_identity: "Apple Distribution",
        profile_name: profile_name,
        bundle_identifier: BUNDLE_ID
      )

      build_app(
        workspace: "ios/App/App.xcworkspace",
        scheme: "App",
        configuration: "Release",
        destination: "generic/platform=iOS",
        export_method: "app-store",
        output_directory: "ios/App/output",
        output_name: "Blackspire.ipa",
        clean: true,
        xcargs: "MARKETING_VERSION=#{MARKETING_VERSION} CURRENT_PROJECT_VERSION=#{build_number}",
        export_options: {
          method: "app-store",
          signingStyle: "manual",
          teamID: team_id,
          provisioningProfiles: { BUNDLE_ID => profile_name },
          uploadSymbols: true,
          manageAppVersionAndBuildNumber: false
        }
      )

      upload_to_testflight(
        api_key: api_key,
        app_identifier: BUNDLE_ID,
        skip_waiting_for_build_processing: false,
        distribute_external: false,
        wait_processing_timeout_duration: 2400
      )

      sh("echo \"build_number=#{build_number}\" >> \"$GITHUB_OUTPUT\"") if ENV["GITHUB_OUTPUT"]
    ensure
      begin
        if certs_before
          now = Spaceship::ConnectAPI::Certificate.all(filter: { certificateType: dist_types.join(",") })
          now.reject { |c| certs_before.include?(c.id) }.each do |c|
            c.delete!
            UI.message("Removed ephemeral distribution certificate created by this run")
          end
        end
      rescue => e
        UI.important("Could not remove ephemeral certificate: #{e.message}")
      end
    end
  end
end
