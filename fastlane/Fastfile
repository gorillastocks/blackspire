default_platform(:ios)

BUNDLE_ID = "com.gorillastocks.blackspire"
MARKETING_VERSION = "1.0.0"

platform :ios do
  desc "Build with automatic signing (App Store Connect API key) and upload to TestFlight"
  lane :beta do
    key_id = ENV.fetch("ASC_KEY_ID")
    issuer_id = ENV.fetch("ASC_ISSUER_ID")
    key_content = ENV.fetch("ASC_KEY_P8")

    # The key lives only in a temp file outside the repo (xcodebuild needs a path) and is removed at the end.
    key_dir = Dir.mktmpdir("asc")
    key_path = File.join(key_dir, "AuthKey_#{key_id}.p8")
    File.write(key_path, key_content)
    File.chmod(0o600, key_path)

    begin
      api_key = app_store_connect_api_key(
        key_id: key_id,
        issuer_id: issuer_id,
        key_content: key_content,
        in_house: false
      )

      # Team ID = bundle ID prefix (seedId) of the already-registered App ID.
      bundle = Spaceship::ConnectAPI::BundleId.find(BUNDLE_ID)
      UI.user_error!("Bundle ID #{BUNDLE_ID} not found in App Store Connect") if bundle.nil?
      team_id = ENV["TEAM_ID"] || bundle.seed_id
      UI.message("Team ID resolved (#{team_id.to_s.length} chars)")

      build_number = latest_testflight_build_number(
        app_identifier: BUNDLE_ID,
        api_key: api_key,
        initial_build_number: 0
      ) + 1
      UI.message("Marketing version #{MARKETING_VERSION}, build #{build_number}")

      auth_flags = "-allowProvisioningUpdates -authenticationKeyPath #{key_path} " \
                   "-authenticationKeyID #{key_id} -authenticationKeyIssuerID #{issuer_id}"

      build_app(
        workspace: "ios/App/App.xcworkspace",
        scheme: "App",
        configuration: "Release",
        destination: "generic/platform=iOS",
        export_method: "app-store",
        output_directory: "ios/App/output",
        output_name: "Blackspire.ipa",
        clean: true,
        xcargs: "#{auth_flags} DEVELOPMENT_TEAM=#{team_id} " \
                "MARKETING_VERSION=#{MARKETING_VERSION} CURRENT_PROJECT_VERSION=#{build_number}",
        export_xcargs: auth_flags,
        export_options: {
          method: "app-store",
          signingStyle: "automatic",
          teamID: team_id,
          uploadSymbols: true,
          manageAppVersionAndBuildNumber: false
        }
      )

      upload_to_testflight(
        api_key: api_key,
        app_identifier: BUNDLE_ID,
        skip_waiting_for_build_processing: false,
        distribute_external: false,
        wait_processing_timeout_duration: 2400
      )

      sh("echo \"build_number=#{build_number}\" >> \"$GITHUB_OUTPUT\"") if ENV["GITHUB_OUTPUT"]
    ensure
      FileUtils.rm_rf(key_dir)
    end
  end
end
