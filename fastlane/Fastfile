default_platform(:ios)

BUNDLE_ID = "com.gorillastocks.blackspire"
MARKETING_VERSION = "1.0.0"
PROFILE_NAME = "Blackspire AppStore CI"
DIST_TYPES = %w[IOS_DISTRIBUTION DISTRIBUTION].freeze

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_content: ENV.fetch("ASC_KEY_P8"),
    in_house: false
  )
end

def list_dist_certs
  Spaceship::ConnectAPI::Certificate.all(filter: { certificateType: DIST_TYPES.join(",") })
end

def team_id_for_bundle
  bundle = Spaceship::ConnectAPI::BundleId.find(BUNDLE_ID)
  UI.user_error!("Bundle ID #{BUNDLE_ID} not found in App Store Connect") if bundle.nil?
  ENV["TEAM_ID"] || bundle.seed_id
end

platform :ios do
  desc "List distribution certificates (never modifies anything) and the latest TestFlight builds"
  lane :info do
    asc_api_key
    list_dist_certs.each do |c|
      UI.message("dist cert id=#{c.id} type=#{c.certificate_type} serial=#{c.serial_number} expires=#{c.expiration_date}")
    end
    Spaceship::ConnectAPI::App.find(BUNDLE_ID).get_builds(limit: 5, sort: "-uploadedDate").each do |b|
      UI.message("build #{b.version} uploaded=#{b.uploaded_date} processing=#{b.processing_state} expired=#{b.expired}")
    end
  end

  desc "ONE-TIME: create a persistent Apple Distribution certificate and write it as an encrypted-by-the-workflow .p12 (never revokes anything)"
  lane :bootstrap_cert do
    asc_api_key
    password = ENV.fetch("DIST_CERT_PASSWORD")
    existing = list_dist_certs
    existing.each do |c|
      UI.message("existing dist cert id=#{c.id} type=#{c.certificate_type} serial=#{c.serial_number} expires=#{c.expiration_date}")
    end

    csr, key = Spaceship::ConnectAPI::Certificate.create_certificate_signing_request
    created = Spaceship::ConnectAPI::Certificate.create(certificate_type: "DISTRIBUTION", csr_content: csr.to_pem)
    UI.message("CREATED dist cert id=#{created.id} serial=#{created.serial_number} expires=#{created.expiration_date}")

    x509 = OpenSSL::X509::Certificate.new(Base64.decode64(created.certificate_content))
    p12 = OpenSSL::PKCS12.create(password, "Blackspire Apple Distribution", key, x509)
    File.write(ENV.fetch("P12_OUT"), Base64.strict_encode64(p12.to_der))
  end

  desc "Build with the persistent distribution cert and upload to TestFlight"
  lane :beta do
    api_key = asc_api_key
    team_id = team_id_for_bundle

    build_number = latest_testflight_build_number(
      app_identifier: BUNDLE_ID,
      api_key: api_key,
      initial_build_number: 0
    ) + 1
    UI.message("Marketing version #{MARKETING_VERSION}, build #{build_number}")

    # The team has no registered devices, so Xcode automatic signing cannot make the development profile an archive
    # wants. Use the persistent Apple Distribution certificate (secrets DIST_CERT_P12 / DIST_CERT_PASSWORD) and an
    # App Store profile that sigh creates/renews through the API key. Nothing is ever revoked.
    setup_ci
    keychain_path = File.expand_path("~/Library/Keychains/#{ENV['MATCH_KEYCHAIN_NAME']}-db")
    p12_path = File.join(Dir.mktmpdir("cert"), "dist.p12")
    File.binwrite(p12_path, Base64.decode64(ENV.fetch("DIST_CERT_P12")))
    import_certificate(
      certificate_path: p12_path,
      certificate_password: ENV.fetch("DIST_CERT_PASSWORD"),
      keychain_path: keychain_path,
      keychain_password: ""
    )
    File.delete(p12_path)
    %w[AppleWWDRCAG3 AppleWWDRCAG6].each do |ca|
      sh("curl -fsSL https://www.apple.com/certificateauthority/#{ca}.cer -o /tmp/#{ca}.cer && security import /tmp/#{ca}.cer -k '#{keychain_path}' -T /usr/bin/codesign || true")
    end

    sigh(
      api_key: api_key,
      app_identifier: BUNDLE_ID,
      team_id: team_id,
      provisioning_name: PROFILE_NAME,
      force: false
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "ios/App/App.xcodeproj",
      team_id: team_id,
      targets: ["App"],
      build_configurations: ["Release"],
      code_sign_identity: "Apple Distribution",
      profile_name: PROFILE_NAME,
      bundle_identifier: BUNDLE_ID
    )

    build_app(
      workspace: "ios/App/App.xcworkspace",
      scheme: "App",
      configuration: "Release",
      destination: "generic/platform=iOS",
      export_method: "app-store",
      output_directory: "ios/App/output",
      output_name: "Blackspire.ipa",
      clean: true,
      xcargs: "MARKETING_VERSION=#{MARKETING_VERSION} CURRENT_PROJECT_VERSION=#{build_number}",
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        teamID: team_id,
        provisioningProfiles: { BUNDLE_ID => PROFILE_NAME },
        uploadSymbols: true,
        manageAppVersionAndBuildNumber: false
      }
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: BUNDLE_ID,
      skip_waiting_for_build_processing: false,
      distribute_external: false,
      wait_processing_timeout_duration: 2400
    )

    sh("echo \"build_number=#{build_number}\" >> \"$GITHUB_OUTPUT\"") if ENV["GITHUB_OUTPUT"]
  end
end
